<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="170dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout android:layout_width="134dp" android:layout_height="134dp" android:background="@drawable/avatar_ring"
        android:duplicateParentState="true" android:padding="7dp">
        <FrameLayout android:id="@+id/avatar_frame" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/avatar_bg">
            <TextView android:id="@+id/initial" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textColor="@android:color/white" android:textSize="46sp" />
            <ImageView android:id="@+id/avatar" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>

    <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:singleLine="true" android:ellipsize="end"
        android:textColor="@color/text3" android:textSize="17sp" />
</LinearLayout>
