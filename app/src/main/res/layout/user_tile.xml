<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="170dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/tile_bg"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout android:id="@+id/avatar_frame" android:layout_width="120dp" android:layout_height="120dp"
        android:background="@drawable/avatar_bg">
        <TextView android:id="@+id/initial" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textColor="@android:color/white" android:textSize="46sp" />
        <ImageView android:id="@+id/avatar" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:singleLine="true" android:ellipsize="end"
        android:textColor="@android:color/white" android:textSize="17sp" />
</LinearLayout>
