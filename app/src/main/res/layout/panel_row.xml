<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/panel_row_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <ImageView android:id="@+id/row_icon" android:layout_width="20dp" android:layout_height="20dp"
        android:layout_marginEnd="14dp" android:duplicateParentState="true" android:tint="@color/btn_text"
        android:importantForAccessibility="no" android:visibility="gone" />
    <TextView android:id="@+id/row_label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:duplicateParentState="true" android:maxLines="2" android:ellipsize="end"
        android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="@color/btn_text" android:textSize="16sp" />
    <ImageView android:id="@+id/row_check" android:layout_width="18dp" android:layout_height="18dp"
        android:layout_marginStart="10dp" android:duplicateParentState="true" android:src="@drawable/ic_check"
        android:tint="@color/btn_text" android:importantForAccessibility="no" android:visibility="gone" />
</LinearLayout>
