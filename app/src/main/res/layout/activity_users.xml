<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="30sp" android:text="Qui regarde ?" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/users" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="36dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:textColor="@color/text2" android:textSize="13sp" android:text="Appui long sur un profil pour le supprimer" />

    <Button android:id="@+id/settings" style="@style/Btn" android:layout_marginTop="18dp" android:layout_marginEnd="0dp" />
</LinearLayout>
