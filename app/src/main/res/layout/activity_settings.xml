<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp">

    <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" android:text="Réglages" />

    <Button android:id="@+id/server" style="@style/Btn" android:layout_marginBottom="10dp" />
    <Button android:id="@+id/burn" style="@style/Btn" android:layout_marginBottom="10dp" />
    <Button android:id="@+id/lang" style="@style/Btn" android:layout_marginBottom="10dp" />
    <Button android:id="@+id/seek" style="@style/Btn" android:layout_marginBottom="10dp" />
    <Button android:id="@+id/bitrate" style="@style/Btn" android:layout_marginBottom="10dp" />
    <Button android:id="@+id/cache" style="@style/Btn" android:layout_marginBottom="10dp" />
    <Button android:id="@+id/logout" style="@style/Btn" android:layout_marginBottom="10dp" android:text="Changer d'utilisateur" />

</LinearLayout>
