<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="20dp"
    android:paddingEnd="40dp">

    <TextView android:id="@+id/title" style="@style/Title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginBottom="10dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="40dp" />
</LinearLayout>
