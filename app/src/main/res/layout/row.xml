<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@android:color/white" android:textSize="17sp" android:layout_marginBottom="0dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:clipToPadding="false" android:paddingStart="4dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:paddingEnd="40dp" />
</LinearLayout>
