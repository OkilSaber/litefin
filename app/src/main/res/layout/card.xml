<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout android:id="@+id/ring" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/ring_bg" android:duplicateParentState="true" android:padding="5dp">
        <FrameLayout android:id="@+id/frame" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/image_round">
            <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <include layout="@layout/card_progress" />
        </FrameLayout>
    </FrameLayout>

    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="6dp" android:paddingEnd="6dp" android:singleLine="true"
        android:ellipsize="end" android:textColor="@color/text3" android:textSize="13sp" />
    <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingBottom="2dp" android:singleLine="true"
        android:ellipsize="end" android:textColor="#FF6B6E76" android:textSize="11sp" />
</LinearLayout>
