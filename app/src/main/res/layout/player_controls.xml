<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Seek preview: thumbnail + landing time (+ jump), with a caret pointing at the scrubber. -->
    <LinearLayout android:id="@+id/preview" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/preview_bg" android:orientation="vertical" android:padding="4dp">
            <ImageView android:id="@+id/preview_image" android:layout_width="240dp" android:layout_height="135dp"
                android:background="@drawable/image_round" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <TextView android:id="@+id/preview_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" android:gravity="center" android:paddingTop="4dp" android:paddingStart="10dp"
                android:paddingEnd="10dp" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/preview_chapter" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:maxWidth="240dp" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingBottom="3dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/text2"
                android:textSize="12sp" android:visibility="gone" />
        </LinearLayout>
        <ImageView android:layout_width="14dp" android:layout_height="7dp" android:src="@drawable/caret_down"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ctl_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="#B8000000" android:orientation="vertical"
        android:paddingStart="40dp" android:paddingTop="14dp" android:paddingEnd="40dp" android:paddingBottom="22dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/ctl_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@android:color/white" android:textSize="17sp" android:singleLine="true"
                android:ellipsize="end" />
            <TextView android:id="@+id/ctl_end" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:fontFeatureSettings="tnum" android:textColor="@color/text2"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@id/exo_position" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" android:textColor="@android:color/white" android:textSize="13sp" />
            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="0dp"
                android:layout_height="26dp" android:layout_weight="1" android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" android:focusable="true" app:played_color="@color/accent"
                app:scrubber_color="@android:color/white" app:ad_marker_color="#E6000000"
                app:played_ad_marker_color="#E6000000" app:ad_marker_width="3dp" />
            <TextView android:id="@id/exo_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum" android:textColor="@android:color/white" android:textSize="13sp" />
        </LinearLayout>

        <TextView android:id="@+id/ctl_chapter" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:singleLine="true" android:textColor="@color/text2" android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/ctl_play" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginEnd="10dp" android:background="@drawable/circle_btn_bg" android:padding="10dp"
                android:scaleType="fitCenter" android:src="@drawable/ic_pause" android:tint="@color/btn_text"
                android:contentDescription="Lecture / Pause" />
            <Button android:id="@+id/ctl_next_chapter" style="@style/Chip" android:drawableStart="@drawable/ic_next"
                android:text="Chapitre suivant" android:visibility="gone" />
            <Button android:id="@+id/ctl_audio" style="@style/Chip" android:drawableStart="@drawable/ic_volume" android:text="Audio" />
            <Button android:id="@+id/ctl_subs" style="@style/Chip" android:drawableStart="@drawable/ic_cc" android:text="Sous-titres" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
