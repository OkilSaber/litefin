<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring drawn around the image with a gap (the image sits inside the 5dp padding). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><stroke android:width="2dp" android:color="@android:color/white" /><corners android:radius="10dp" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>
