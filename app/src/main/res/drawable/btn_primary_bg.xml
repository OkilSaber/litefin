<?xml version="1.0" encoding="utf-8"?>
<!-- The one primary action of a screen: accent at rest, white when focused like every button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape><solid android:color="#FFC8CACF" /><corners android:radius="22dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@android:color/white" /><corners android:radius="22dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/accent" /><corners android:radius="22dp" /></shape>
    </item>
</selector>
